%robot moves according to the given csv file
pub = rospublisher('/cmd_vel', 'geometry_msgs/Twist');
msg = rosmessage(pub);
T = readtable('stage12_turtle_cmd_vel_schedule.csv');
linear_velocities = T.linear_velocity_mps;   % replace with your actual column name
linear_velocities = linear_velocities ./ 3.6;
angular_velocities = T.angular_velocity_radps;   % replace with your actual column name

rate = rosrate(10);   % Hz — match this to how fast you want to send commands
for i = 1:length(linear_velocities)
   msg.Linear.X = linear_velocities(i);   % m/s — convert from kph if needed
   msg.Angular.Z = angular_velocities(i);              % set angular velocity if needed
   send(pub, msg);
   waitfor(rate);
end
% Stop the robot after the loop
msg.Linear.X = 0;
msg.Angular.Z = 0;
send(pub, msg);
