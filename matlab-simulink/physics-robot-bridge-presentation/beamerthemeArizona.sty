%%%%%%%%%%%% final page
% this command creates the "We're always looking for new graduate students" page
% which also has a link to the ECE website.
\newcommand{\finalpage}
{
\frame{
  \setlength\leftmargin{0pt} 
  \vskip -14.25em
  {
    \hbox to 0pt{\hss\vtop{%
        \normalsize%
        \@tempdima=.25\paperwidth%
        \advance\@tempdima by-3ex%
        \hsize=\@tempdima%
        \leftskip=0pt plus 1fill%
        \rightskip=0pt\relax%
        \leavevmode
    % \leavevmode%
    %\hskip -3em
    \centering{
    \includegraphics[width=1.22\paperwidth]{tucsonphoto}
    }
    % 
    }%\kern#2
    }%
    \vskip 0pt
  }
  % \frametitle{We're always looking for good graduate students.}
  \vskip -25em
  \hbox{\begin{beamercolorbox}[wd=0.75\paperwidth,ht=2.5ex,dp=1.125ex,leftskip=.3cm,rightskip=.3cm plus1fil]{final page}
    \usebeamerfont{final page}
    \vskip 0.5em
\vspace{1in}
\centering
    \textbf{\large{\color{white} Thanks for your attention \\ Questions?}}
    \vskip 0.5em
%    {\Large \url{http://ece.arizona.edu/} }
  \end{beamercolorbox}
  }
  % \includegraphics[width=0.4\paperwidth]{UA_horiz_color}
}
}

