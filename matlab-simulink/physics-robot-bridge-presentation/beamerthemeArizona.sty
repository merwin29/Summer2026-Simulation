\ProvidesPackage{beamerthemeArizona}

\DeclareOptionBeamer{hideothersubsections}{\PassOptionsToPackage{hideothersubsections=#1}{beamerouterthemesidebar}}
\DeclareOptionBeamer{hideallsubsections}{\PassOptionsToPackage{hideallsubsections=#1}{beamerouterthemesidebar}}

\DeclareOptionBeamer{width}{\PassOptionsToPackage{width=#1}{beamerouterthemesidebar}}
\DeclareOptionBeamer{left}{\PassOptionsToPackage{left}{beamerouterthemesidebar}}
\DeclareOptionBeamer{right}{\PassOptionsToPackage{right}{beamerouterthemesidebar}}
\ProcessOptionsBeamer

\logo{\hfill\includegraphics[height=0.75cm]{UA_block_color}}
\titlegraphic{\includegraphics[height=1.0cm]{UA_horiz_color}}
% \logo{\hfill\includegraphics[width=0.9\beamer@sidebarwidth]{UA_block_blk}}
% \titlegraphic{\includegraphics[height=0.9\beamer@headheight]{UA_horiz_blk}}

\mode<presentation>

% \useoutertheme{sidebar}
% \useoutertheme{split}
\useoutertheme{smoothbars}
\useinnertheme{rounded}

% we supplement our theme, in case...
\defbeamertemplate*{footline}{smoothbars theme}
{%
  \leavevmode%
  \hbox{\begin{beamercolorbox}[wd=.35\paperwidth,ht=2.5ex,dp=1.125ex,leftskip=.3cm plus1fill,rightskip=.3cm]{author in head/foot}%
    \usebeamerfont{author in head/foot}\insertshortauthor
  \end{beamercolorbox}%
  \begin{beamercolorbox}[wd=.65\paperwidth,ht=2.5ex,dp=1.125ex,leftskip=.3cm,rightskip=.3cm plus1fil]{title in head/foot}%
    \usebeamerfont{title in head/foot}\insertshorttitle \hfill \thepage
  \end{beamercolorbox}}%
  \vskip0pt%
}

\usecolortheme{wildcat}
\usecolortheme{orchid}
% \usecolortheme{whale}

\usefonttheme{professionalfonts}
\setbeamercovered{invisible}

\mode
<all>

